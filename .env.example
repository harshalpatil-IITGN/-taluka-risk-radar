# === Database (Supabase Postgres + pgvector) ===
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-anon-key>

# === Data Sources ===
DATA_GOV_IN_API_KEY=<your-data-gov-in-api-key>

# === LLM / AI ===
GEMINI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<random-secret-for-webhook-verification>

# === API Security ===
ADMIN_TOKEN=<random-admin-token-for-admin-endpoints>

# === CORS ===
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# === Mock Mode (NEVER true in production/demo) ===
MOCK_MODE=false
